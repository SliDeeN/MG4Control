<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- Écran principal unique (Drive + Regen + ADAS + Climat + Alertes) -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.mg4.control.ui.DashboardFragment"
        android:label="Dashboard" />

    <!-- Profils de conduite (bouton PROFILS dans la top-bar) -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mg4.control.ui.ProfileFragment"
        android:label="@string/nav_profiles" />

    <!-- Création / édition d'un profil — plein écran, empilé sur la liste -->
    <fragment
        android:id="@+id/profileEditFragment"
        android:name="com.mg4.control.ui.ProfileEditFragment"
        android:label="@string/profile_edit" />

    <!-- Statistiques : trajets, recharges et coût (bouton STATISTIQUES) -->
    <fragment
        android:id="@+id/statsFragment"
        android:name="com.mg4.control.ui.StatsFragment"
        android:label="@string/nav_stats" />

    <!-- Réglages (bouton RÉGLAGES dans la top-bar) -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.mg4.control.ui.SettingsFragment"
        android:label="@string/nav_settings" />

    <!-- Raccourcis volant (bouton RACCOURCIS dans la top-bar) -->
    <fragment
        android:id="@+id/shortcutsFragment"
        android:name="com.mg4.control.ui.ShortcutsFragment"
        android:label="@string/nav_shortcuts" />

    <!-- Audio (bouton AUDIO dans la top-bar — A9 uniquement) -->
    <fragment
        android:id="@+id/audioFragment"
        android:name="com.mg4.control.ui.AudioFragment"
        android:label="@string/nav_audio" />

    <!-- Automatisation (bouton AUTOMATISATION dans la top-bar) -->
    <fragment
        android:id="@+id/automationFragment"
        android:name="com.mg4.control.ui.AutomationFragment"
        android:label="@string/nav_automation" />

</navigation>
