    <string name="battery_auto_threshold_label">Battery threshold</string>
    <string name="battery_auto_note">Triggers once when the battery drops below the threshold, at start-up or while driving. Re-arms at every start, or after charging above the threshold. If driving safety blocks settings at the current speed, the profile waits for the next stop.</string>
    <string name="battery_auto_confirm_msg">The battery has dropped below %1$d %%\n(%2$s %% now)\nApply profile “%3$s”?</string>
    <string name="autobri_title">Automatic brightness</string>
    <string name="autobri_desc">Set the screen brightness from the outdoor light when the car goes READY</string>
    <string name="autobri_desc_offline">Set the screen brightness from the state of the lights when the car goes READY</string>
    <string name="autobri_follow_desc_offline">Every time the lights switch on or off (tunnel, car park, nightfall). Adjusting brightness by hand pauses the automation until the next start.</string>
    <string name="autobri_level_lights_off">Lights off (day)</string>
    <string name="autobri_level_lights_on">Lights on (night, garage, tunnel)</string>
    <string name="autobri_source_lights_off">lights off</string>
    <string name="autobri_status_lights">Last setting: %1$s · %2$s → %3$d %%</string>
    <string name="autobri_note_offline">Works with the light switch on AUTO: the automatic lights are what detect darkness. Without the “Adjust brightness while driving” box, the setting is made at start-up, then once when leaving a garage. Each change fades in over one second.</string>
    <string name="autobri_follow">Adjust brightness while driving (not only at start-up)</string>
    <string name="autobri_follow_desc">The light is recalculated every minute; the screen is only readjusted when the gap reaches 10 points. Adjusting brightness by hand pauses the automation until the next start.</string>
    <string name="autobri_lights">Use the lights switching on and off (brightness lowered in garages and tunnels, even in broad daylight)</string>
    <string name="autobri_lights_desc">Side lights on: Night point of the curve; once they switch off, weather-based setting. Untick if you drive with lights on during the day.</string>
    <string name="autobri_sources"><b>Based on</b> (at least one source)</string>
    <string name="autobri_lights_desc_only">Lights off: “day” level; lights on: “night” level, both adjustable below.</string>
    <string name="autobri_lights_desc_off">Unticked: the screen may stay bright in garages or tunnels.</string>
    <string name="autobri_forecast">Use the Open-Meteo weather</string>
    <string name="autobri_forecast_warning">(uses a little mobile data)</string>
    <string name="autobri_forecast_desc">Light estimated from the sun height and the sunshine forecast around the car: about 10 KB per download, every 8 h at most or when leaving the area (~60 km).</string>
    <string name="autobri_mode_lights">Lights only: no mobile data, no GPS</string>
    <string name="autobri_mode_both">Weather + lights: ~10 KB per download</string>
    <string name="autobri_mode_forecast">Weather only: ~10 KB per download, no garage/tunnel safeguard</string>
    <string name="autobri_follow_desc_lights">The light is recalculated every minute; the screen is only readjusted when the gap reaches 10 points, and every time the lights switch on or off. Adjusting brightness by hand pauses the automation until the next start.</string>
    <string name="autobri_night_lights">Night or lights on · 10 lx</string>
    <string name="autobri_status_failed_lights">Could not set: lights state unreadable.</string>
    <string name="autobri_status_paused">Paused until the next start: brightness adjusted by hand.</string>
    <string name="autobri_curve_label">Screen brightness by outdoor light</string>
    <string name="autobri_night">Night · 10 lx</string>
    <string name="autobri_twilight">Dusk · 400 lx</string>
    <string name="autobri_overcast">Overcast · 10,000 lx</string>
    <string name="autobri_sunny">Full sun · 80,000 lx</string>
    <string name="autobri_test">Test now</string>
    <string name="autobri_status">Last setting: %1$s · %2$s · ≈ %3$s lx → %4$d %%</string>
    <string name="autobri_status_none">No setting yet.</string>
    <string name="autobri_status_failed">Could not set: position or time unavailable.</string>
    <string name="autobri_source_lights">lights on</string>
    <string name="autobri_source_forecast">weather forecast</string>
    <string name="autobri_source_sun">sun position</string>
    <string name="autobri_note">Outdoor light is estimated from the sun height and the Open-Meteo sunshine forecast (CC BY 4.0) over an area of about 60 × 60 km around the car, downloaded for 3 days and refreshed every 8 h at most or when leaving the area, with a position rounded to ~10 km. Without a forecast, a clear sky is assumed. Each change fades in over one second.</string>

