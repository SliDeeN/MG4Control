<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MG4Control" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Refonte 2.7.0 : curseurs, cases à cocher et barres de progression prennent l'accent. -->
        <item name="colorPrimary">@color/dash_accent</item>
        <item name="colorPrimaryVariant">@color/bg_card</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Pré-climatisation (issue #130) : écran de suivi plein écran, fond noir dès l'ouverture. -->
    <style name="Theme.MG4Control.PreClimate">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Refonte 2.7.0 : onglet de la barre du haut. Inactif : sans fond ni bordure, texte secondaire ;
         l'onglet actif reçoit un fond (MainActivity, à chaque changement d'écran). -->
    <style name="Widget.MG4.TopTab" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">17sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">17sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
