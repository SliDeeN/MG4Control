<?xml version="1.0" encoding="utf-8"?>
<!-- « Corriger le tarif » d'une session, sans clavier (même choix que « Compléter la session »,
     2026-10-13) : le prix entre un − et un +, et dessous le pas de ces boutons — du millième à
     l'unité en euros, plus gros pour une monnaie où le kWh vaut des milliers (PriceStepper).

     Fenêtre de l'application : tailles normales, pas l'agrandissement des pop-ups. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hvac_modern_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_dialog_icon">

            <ImageView
                android:id="@+id/tariff_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dialog_plug" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_fix_tariff"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_fix_tariff_note"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_hvac_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/tariff_minus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dialog_tile"
                android:padding="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hvac_minus" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tariff_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <!-- Monnaie par kWh -->
                <TextView
                    android:id="@+id/tariff_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:maxLines="1" />

            </LinearLayout>

            <ImageView
                android:id="@+id/tariff_plus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dialog_tile"
                android:padding="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hvac_plus" />

        </LinearLayout>

        <!-- Le pas des deux boutons ; les cases sont ajoutées par AppDialog.segments -->
        <LinearLayout
            android:id="@+id/tariff_steps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dialog_segments"
            android:orientation="horizontal"
            android:padding="4dp"
            android:baselineAligned="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tariff_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_tile"
            android:gravity="center"
            android:text="@string/nav_close"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tariff_default"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_dialog_tile"
            android:gravity="center"
            android:text="@string/stats_tariff_default"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tariff_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_dialog_primary"
            android:gravity="center"
            android:text="@string/stats_save"
            android:textColor="@color/hvac_on_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>

</LinearLayout>
