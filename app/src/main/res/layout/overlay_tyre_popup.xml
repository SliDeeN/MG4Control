<?xml version="1.0" encoding="utf-8"?>
<!-- Pression des pneus (maquette du 2026-11-20) : les quatre pneus autour de la voiture vue de
     dessus, l'unité au choix dans l'en-tête (bar, PSI, kPa). Carte de base 1140 × 470 dp, agrandie
     comme les autres pop-ups (OverlayKit.contextes). Rempli par TyrePopupOverlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tyre_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/tyre_card"
        android:layout_width="1140dp"
        android:layout_height="470dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_hvac_modern_card"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- ── En-tête : titre, unité, fermeture ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/tyre_title_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sym_tire_repair" />

            <TextView
                android:id="@+id/tyre_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/tyre_popup_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Unité : trois cases, la choisie en accent ; fond peint par le code. -->
            <LinearLayout
                android:id="@+id/tyre_units"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tyre_unit_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="72dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="16sp"
                    />

                <TextView
                    android:id="@+id/tyre_unit_psi"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="72dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="16sp"
                    />

                <TextView
                    android:id="@+id/tyre_unit_kpa"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="72dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="16sp"
                    />

            </LinearLayout>

            <ImageView
                android:id="@+id/tyre_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/nav_close"
                android:scaleType="center"
                android:src="@drawable/ic_hvac_close" />

        </LinearLayout>

        <!-- ── Les quatre pneus autour de la voiture ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <include android:id="@+id/tyre_fl" layout="@layout/item_tyre_card" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <include android:id="@+id/tyre_rl" layout="@layout/item_tyre_card" />

            </LinearLayout>

            <com.mg4.control.ui.widget.TyreCarView
                android:id="@+id/tyre_car"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <include android:id="@+id/tyre_fr" layout="@layout/item_tyre_card" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <include android:id="@+id/tyre_rr" layout="@layout/item_tyre_card" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Pied : rappel sur la pression à chaud (pas de minuterie : fermé à la main) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/tyre_popup_hint"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
