<?xml version="1.0" encoding="utf-8"?>
<!-- Guidage AA / CarPlay : outil de relevé (issue #285, 2026-11-28), débloqué avec le Diagnostic.
     Trois pastilles d'état, le dernier guidage reçu d'AllGo (flèche + textes), les compteurs, puis
     les données brutes du dernier message. Rempli par NavDebugDialog, relu chaque seconde.
     Fenêtre de l'application : tailles normales, pas l'agrandissement des pop-ups. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hvac_modern_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/nav_badge"
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/nav_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sym_route" />

        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/btn_nav_debug"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/nav_close"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_round"
            android:padding="15dp"
            android:contentDescription="@string/nav_close"
            android:src="@drawable/ic_hvac_close" />

    </LinearLayout>

    <!-- Pastilles : service AllGo, session, guidage. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nav_chip_service"
            style="@style/NavDebugChip" />

        <TextView
            android:id="@+id/nav_chip_session"
            style="@style/NavDebugChip"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/nav_chip_guidance"
            style="@style/NavDebugChip"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Dernier guidage reçu : la flèche envoyée par le téléphone et ce qu'on sait lire. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:background="@drawable/bg_hvac_panel"
            android:padding="16dp">

            <TextView
                style="@style/NavDebugLabel"
                android:text="@string/nav_debug_last" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="128dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/nav_arrow"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_marginEnd="16dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nav_big"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/nav_line1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/nav_line2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/nav_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dash_text_lo"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Compteurs depuis le démarrage et rappels AllGo vus. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_hvac_panel"
            android:padding="16dp">

            <TextView
                style="@style/NavDebugLabel"
                android:text="@string/nav_debug_counts" />

            <TextView
                android:id="@+id/nav_counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/NavDebugLabel"
                android:layout_marginTop="12dp"
                android:text="@string/nav_debug_callbacks" />

            <TextView
                android:id="@+id/nav_callbacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- Données brutes du dernier message, comme dans le journal MG4_NAV. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_hvac_panel"
        android:padding="16dp">

        <TextView
            style="@style/NavDebugLabel"
            android:text="@string/nav_debug_raw" />

        <TextView
            android:id="@+id/nav_raw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:textIsSelectable="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_debug_hint"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nav_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/dash_text_lo"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
