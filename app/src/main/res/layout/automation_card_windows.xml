<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte « Vitres » de l'onglet Automatisation (elle occupait un onglet temporaire du tableau
    de bord). Trois sections dans un seul dépliage : commande des quatre vitres, calibration,
    fermeture automatique en quittant la voiture.

    Le chevron replie la carte entière, comme les deux autres cartes de l'onglet ; l'interrupteur
    de fermeture automatique ne commande QUE sa section, la commande manuelle et la calibration
    devant rester utilisables sans elle.

    Les boutons de vitre sont pilotés au toucher par WindowsPanel
    (appui court = course auto, appui long = manuel tant que le doigt reste posé).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_windows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/win_automation_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_windows_expand"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_windows_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_section_command"
                android:textColor="@color/dash_text_lo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="7dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp" />

            <!-- Les courses émulées n'ont pas l'anti-pincement de la course native du véhicule -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_close_warning"
                android:textColor="@color/dash_warn"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp" />

            <!-- Rangée avant -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp">

                <include
                    android:id="@+id/win_tile_front_left"
                    layout="@layout/dash_window_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp" />

                <include
                    android:id="@+id/win_tile_front_right"
                    layout="@layout/dash_window_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />

            </LinearLayout>

            <!-- Rangée arrière -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp">

                <include
                    android:id="@+id/win_tile_rear_left"
                    layout="@layout/dash_window_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp" />

                <include
                    android:id="@+id/win_tile_rear_right"
                    layout="@layout/dash_window_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />

            </LinearLayout>

            <!-- Toutes les vitres -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_all_close"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_all_close"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_window_all_up"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"
                    app:iconTint="@color/text_secondary"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_all_open"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_all_open"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_window_all_down"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"
                    app:iconTint="@color/text_secondary"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_border"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_cal_title"
                android:textColor="@color/dash_text_lo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="7dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_cal_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_cal_limits"
                android:textColor="@color/dash_warn"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp" />


            <include
                android:id="@+id/win_cal_row_front_left"
                layout="@layout/dash_window_cal_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/win_cal_row_front_right"
                layout="@layout/dash_window_cal_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/win_cal_row_rear_left"
                layout="@layout/dash_window_cal_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/win_cal_row_rear_right"
                layout="@layout/dash_window_cal_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Assistant : masqué jusqu'à « Calibrer ». Textes et bouton d'action pilotés par le code. -->
            <LinearLayout
                android:id="@+id/win_cal_wizard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_rounded"
                android:layout_margin="10dp"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/win_cal_wizard_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/win_cal_wizard_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/win_cal_wizard_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/win_cal_wizard_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/win_cal_warning"
                    android:textColor="@color/dash_warn"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/win_cal_wizard_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_cal_action"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:iconGravity="textStart"
                    app:iconSize="32dp"
                    app:iconTint="@color/text_primary"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_cal_cancel"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_cal_cancel"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_cal_redo"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_cal_redo"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_cal_save"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_cal_save"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_border"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_auto_title"
                android:textColor="@color/dash_text_lo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="7dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/win_auto_label"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/win_auto_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switch_win_autoclose"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:layout_marginHorizontal="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:id="@+id/win_auto_cal_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_auto_need_cal"
                android:textColor="@color/dash_accent"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_auto_warning"
                android:textColor="@color/dash_warn"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp" />

            <LinearLayout
                android:id="@+id/row_win_auto_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


            <!-- Armement : conditions réglables (vitesse et/ou durée), valeurs posées par le code -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_auto_arming_title"
                android:textColor="@color/dash_text_lo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/win_auto_speed_label"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/win_auto_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:gravity="end"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace" />

                <Switch
                    android:id="@+id/switch_win_auto_speed"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:layout_marginHorizontal="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_win_auto_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:valueFrom="5"
                android:valueTo="50"
                android:value="20"
                android:stepSize="5"
                app:labelBehavior="gone"
                app:thumbRadius="14dp"
                app:trackHeight="10dp"
                app:thumbColor="@color/dash_accent"
                app:trackColorActive="@color/dash_accent"
                app:trackColorInactive="@color/dash_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/win_auto_time_label"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/win_auto_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:gravity="end"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace" />

                <Switch
                    android:id="@+id/switch_win_auto_time"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:layout_marginHorizontal="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_win_auto_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:valueFrom="1"
                android:valueTo="15"
                android:value="5"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:thumbRadius="14dp"
                app:trackHeight="10dp"
                app:thumbColor="@color/dash_accent"
                app:trackColorActive="@color/dash_accent"
                app:trackColorInactive="@color/dash_border" />

            <!-- Les deux conditions actives : l'une ou l'autre (winclose) / les deux -->
            <LinearLayout
                android:id="@+id/win_auto_combine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_auto_any"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_auto_combine_any"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_auto_all"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/win_auto_combine_all"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Délai entre la sortie de READY et la fermeture -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/win_auto_delay_label"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/win_auto_delay_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:gravity="end"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_win_auto_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:valueFrom="0"
                android:valueTo="30"
                android:value="5"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:thumbRadius="14dp"
                app:trackHeight="10dp"
                app:thumbColor="@color/dash_accent"
                app:trackColorActive="@color/dash_accent"
                app:trackColorInactive="@color/dash_border" />



            <!-- Bip d'avertissement pendant le délai (comportement de winclose) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/win_auto_beep_label"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/win_auto_beep_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switch_win_auto_beep"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:layout_marginHorizontal="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Volume du bip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/win_auto_beep_volume_label"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/win_auto_beep_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:gravity="end"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_win_auto_beep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:valueFrom="10"
                android:valueTo="100"
                android:value="80"
                android:stepSize="5"
                app:labelBehavior="gone"
                app:thumbRadius="14dp"
                app:trackHeight="10dp"
                app:thumbColor="@color/dash_accent"
                app:trackColorActive="@color/dash_accent"
                app:trackColorInactive="@color/dash_border" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
