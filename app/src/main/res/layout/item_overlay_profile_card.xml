<?xml version="1.0" encoding="utf-8"?>
<!-- Une carte du sélecteur de profils (overlay_profile_picker.xml) : la pastille du mode de
     conduite, l'étiquette « Actif » du profil en cours, le nom, un résumé, et en bas ce que fait
     un appui. Largeur, fond et teintes sont posés par ProfilePickerOverlay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Mode de conduite ; invisible si le profil n'applique pas la catégorie Conduite -->
        <TextView
            android:id="@+id/profile_card_mode"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/profile_card_active"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/overlay_profile_active"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/profile_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/profile_card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/profile_card_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
