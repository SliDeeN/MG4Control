<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal de l'activité.
    Refonte B (2026-11-02) : plus de barre du haut, le menu principal est une colonne à gauche —
    la hauteur est la dimension rare de l'écran (≈ 650 dp utiles), elle va toute au contenu.
      • En tête, le logo "MG4Control" : il ramène au Tableau de bord, écran par défaut qui n'a donc
        plus d'onglet (cinq appuis débloquent toujours le Diagnostic)
      • Puis, à parts égales de la hauteur : PROFILS, RACCOURCIS, AUTOMATISATION, STATISTIQUES,
        RÉGLAGES — pictogramme au-dessus, libellé sur deux lignes au plus
    La zone de contenu à droite est gérée par le NavController.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/dash_bg">

    <!-- ── MENU PRINCIPAL ──────────────────────────────────────────── -->
    <!-- Volant à droite (Réglages › Interface › Côté du menu) : MainActivity le passe après le
         contenu. Pas de trait entre le menu et le contenu (retiré le 2026-11-03, sa demande). -->
    <LinearLayout
        android:id="@+id/nav_column"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@color/dash_bg">

        <!--
            Logo transparent, avec une variante de couleur pour chaque thème. Le cadre prend un fond quand le Tableau de bord est affiché (MainActivity).
        -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings_default_screen_dashboard">

            <ImageView
                android:id="@+id/nav_logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:maxHeight="48dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/brand_wordmark_blue"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <com.mg4.control.ui.widget.RailButton
            android:id="@+id/btn_nav_profiles"
            style="@style/Widget.MG4.NavItem"
            android:text="@string/nav_profiles"
            app:icon="@drawable/ic_nav_profiles" />

        <com.mg4.control.ui.widget.RailButton
            android:id="@+id/btn_nav_shortcuts"
            style="@style/Widget.MG4.NavItem"
            android:text="@string/nav_shortcuts"
            app:icon="@drawable/ic_nav_shortcuts" />

        <com.mg4.control.ui.widget.RailButton
            android:id="@+id/btn_nav_automation"
            style="@style/Widget.MG4.NavItem"
            android:text="@string/nav_automation"
            app:icon="@drawable/ic_nav_automation" />

        <com.mg4.control.ui.widget.RailButton
            android:id="@+id/btn_nav_stats"
            style="@style/Widget.MG4.NavItem"
            android:text="@string/nav_stats"
            app:icon="@drawable/ic_nav_stats" />

        <com.mg4.control.ui.widget.RailButton
            android:id="@+id/btn_nav_settings"
            style="@style/Widget.MG4.NavItem"
            android:text="@string/nav_settings"
            app:icon="@drawable/ic_nav_settings" />

    </LinearLayout>

    <!-- ── ZONE DE CONTENU (NavController) ────────────────────────── -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</LinearLayout>
