<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'essai « Lock when leaving » (provisoire). À gauche le réglage relu chaque seconde,
     la consigne et le journal ; à droite ce qui permet de suivre un essai clé en main. Deux
     colonnes : l'écran de bord est large et bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_probe_setting"
            android:textColor="@color/dash_text_lo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/lock_probe_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:textColor="@color/dash_accent"
                android:textSize="56sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/lock_probe_meaning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_probe_enable"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/lock_probe_enable"
                android:textColor="@color/dash_warn"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_warn_dim"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_warn"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_probe_disable"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/lock_probe_disable"
                android:textColor="@color/dash_warn"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_warn_dim"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_warn"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_probe_read"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/lock_probe_read"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_probe_clear"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/lock_probe_clear"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_probe_close"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/nav_close"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/lock_probe_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lock_probe_journal"
            android:textColor="@color/dash_text_lo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:textAllCaps="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/lock_probe_journal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="monospace" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_probe_context"
            android:textColor="@color/dash_text_lo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:textAllCaps="true" />

        <!-- Hauteur bornée : une lecture refusée affiche le nom de l'erreur, parfois long. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/lock_probe_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="monospace" />

        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lock_probe_hint"
            android:textColor="@color/dash_text_lo"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
