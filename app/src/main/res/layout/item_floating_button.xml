<?xml version="1.0" encoding="utf-8"?>
<!-- Boutons flottants : une ligne de la liste — aperçu de la bulle, son raccourci et ses tailles,
     Modifier et Supprimer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_sound_slot"
    android:padding="10dp">

    <TextView
        android:id="@+id/floating_row_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/floating_row_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_floating_row_edit"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/floating_edit"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:backgroundTint="@color/dash_btn"
        app:strokeWidth="1dp"
        app:strokeColor="@color/dash_border"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_floating_row_delete"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/floating_delete"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:backgroundTint="@color/dash_btn"
        app:strokeWidth="1dp"
        app:strokeColor="@color/dash_border"
        app:cornerRadius="8dp" />

</LinearLayout>
