<?xml version="1.0" encoding="utf-8"?>
<!-- « Firmware non reconnu » : affichée à l'ouverture quand le firmware de la voiture n'est aucun
     de ceux que l'application connaît, et qu'aucun mode de compatibilité n'a encore été choisi.
     Deux sorties : fermer l'application, ou continuer — ce qui ouvre Réglages › Infos, là où le
     firmware se choisit (MainActivity.checkUnknownFirmware).

     Même construction que les confirmations de l'application (dialog_confirm.xml, style choisi
     sur maquette le 2026-10-13), en ton d'avertissement, avec deux éléments de plus : le firmware
     lu sur la voiture, en pastille, et la consigne dans un encadré.

     Fenêtre de l'application : tailles normales, pas l'agrandissement des pop-ups. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hvac_modern_card"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dialog_icon_warn">

        <ImageView
            android:id="@+id/iv_fw_unknown_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dialog_warning" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_fw_unknown_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:textColor="@color/text_primary"
        android:textSize="23sp"
        android:textStyle="bold" />

    <!-- Ce que la voiture annonce (ex. « SWI70-27958-1213R ») -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_tile"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_firmware_version"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_fw_detected_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Poids : c'est ce qui laisse le texte rétrécir — et défiler — sur un écran peu haut. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/tv_fw_unknown_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/fw_unknown_body"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

    </ScrollView>

    <!-- Ce que fait « Continuer » -->
    <TextView
        android:id="@+id/tv_fw_unknown_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dialog_hint"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/btn_fw_close_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_tile"
            android:gravity="center"
            android:text="@string/fw_unknown_btn_close"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btn_fw_continue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_dialog_warn"
            android:gravity="center"
            android:text="@string/fw_unknown_btn_continue"
            android:textColor="@color/hvac_on_heat"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>

</LinearLayout>
