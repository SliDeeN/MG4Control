<?xml version="1.0" encoding="utf-8"?>
<!-- Éditeur de Mes automatisations (issue #201, étape 2) : une colonne façon Home Assistant.
     En tête le nom et l'interrupteur, puis les sections Quand / Et si / Alors / Options, construites
     par CustomRuleEditFragment dans rule_edit_body ; en pied Journal, Tester, Annuler, Enregistrer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/rule_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rule_edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:maxLength="40"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/rule_enabled"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />

        <com.mg4.control.ui.widget.SegmentSwitch
            android:id="@+id/rule_edit_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/rule_edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/rule_edit_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dash_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_edit_journal"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:minWidth="150dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rule_journal"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_edit_test"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:minWidth="150dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rule_test"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_edit_cancel"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:minWidth="170dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/profile_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="19sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_edit_save"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:minWidth="200dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rule_save"
            android:textColor="@color/dash_on_accent"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_accent"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
