<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:gravity="center"
    android:padding="20dp">

    <!-- ── Carte « Volume à l'ouverture de porte » (SWI132/133) ── -->
    <LinearLayout
        android:id="@+id/door_volume_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/door_volume_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/door_volume_desc_text"
                    android:text="@string/door_volume_desc"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/switch_door_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:id="@+id/door_volume_level_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/door_volume_level_label"
            android:textColor="@color/dash_text_lo"
            android:textSize="14sp"
            android:layout_marginTop="14dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_door_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="30"
            android:value="0"
            android:stepSize="1" />

        <!-- Restaurer le volume à la fermeture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/door_volume_restore_label"
                android:text="@string/door_volume_restore_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_door_restore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Choix des portes déclencheuses (masqué sans détection de porte : déclenchement par READY) -->
        <TextView
            android:id="@+id/door_volume_doors_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/door_volume_doors_label"
            android:textColor="@color/dash_text_lo"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/door_volume_doors_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <CheckBox
                android:id="@+id/cb_door_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/door_left"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="24dp" />

            <CheckBox
                android:id="@+id/cb_door_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/door_right"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
