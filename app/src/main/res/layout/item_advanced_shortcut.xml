<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de la liste des raccourcis avancés.

     Le bouton et le type d'appui sont montés dans l'en-tête de groupe (item_advanced_group) :
     une même touche et un même appui portent désormais plusieurs lignes, une par profil, et les
     répéter à chaque ligne noierait la seule information qui les distingue. Reste donc ici le
     PROFIL, la fonction, et les deux actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_section_rounded"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- « Tous les profils », ou le nom du profil auquel la ligne est réservée. Les variantes
         sont préfixées d'un chevron par le code, pour qu'un coup d'œil suffise à voir laquelle
         sert de repli. -->
    <TextView
        android:id="@+id/adv_item_profile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Poids plus large que la colonne de gauche : les libellés de fonction sont longs
         (« Siège chauffant gauche : cycle »), et une ligne tronquée ne dirait plus laquelle. -->
    <TextView
        android:id="@+id/adv_item_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:layout_marginEnd="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Modifier : change la fonction et le profil, sans refaire touche et type d'appui. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/adv_item_edit"
        android:layout_width="84dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:text="@string/adv_sc_edit"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/dash_btn"
        app:strokeWidth="1dp"
        app:strokeColor="@color/dash_border"
        app:cornerRadius="8dp" />

    <!-- Sans suppression, un raccourci enregistré par erreur serait définitif. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/adv_item_delete"
        android:layout_width="84dp"
        android:layout_height="52dp"
        android:text="@string/adv_sc_delete"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/dash_btn"
        app:strokeWidth="1dp"
        app:strokeColor="@color/dash_border"
        app:cornerRadius="8dp" />

</LinearLayout>
