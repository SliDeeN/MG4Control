<?xml version="1.0" encoding="utf-8"?>
<!-- Personnalisation avancée de l'écran conducteur (issue #229, 2026-11-12, maquette validée) :
     à gauche l'aperçu du carré du combiné, à l'échelle ×2, qu'on touche pour choisir un élément
     et qu'on presse longuement pour le déplacer ; à droite les réglages de l'élément choisi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hvac_modern_card"
    android:padding="20dp">

    <!-- Titre et profils réglés sur une seule ligne : la fenêtre doit tenir dans la hauteur de
         l'écran (boutons du bas rognés en voiture, 2026-11-12). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_cluster_layout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cluster_layout_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cluster_layout_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/frame_cluster_layout_preview"
                android:layout_width="400dp"
                android:layout_height="400dp"
                android:background="@drawable/bg_card_rounded">

                <TextView
                    android:id="@+id/tv_cluster_layout_preview_none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_horizontal"
                android:text="@string/cluster_layout_hint"
                android:textColor="@color/dash_text_lo"
                android:textSize="15sp" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_cluster_layout_panel"
            android:layout_width="0dp"
            android:layout_height="424dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@+id/panel_cluster_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cluster_layout_reset"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cluster_layout_reset"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cluster_layout_cancel"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="160dp"
            android:text="@string/profile_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cluster_layout_save"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="180dp"
            android:layout_marginStart="12dp"
            android:text="@string/rule_save"
            android:textAllCaps="false"
            android:textColor="@color/dash_accent"
            android:textSize="18sp"
            app:backgroundTint="@color/dash_accent_dim"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_accent"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
