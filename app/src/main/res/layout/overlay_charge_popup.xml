<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up de charge (maquette A, 2026-10-16) : à gauche la batterie et le curseur de la limite,
     au centre la courbe depuis le début de la charge, à droite les chiffres — ou l'éditeur du prix
     du kWh. Carte de base 1140 × 400 dp, agrandie comme le pop-up HVAC (OverlayKit.contextes). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/charge_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="1140dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_hvac_modern_card"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- ── En-tête : titre, type de charge, fermeture (pas de décompte : il ne se ferme pas seul) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/charge_title_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cluster_bolt" />

            <TextView
                android:id="@+id/charge_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/charge_popup_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/charge_pill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_dialog_pill_accent"
                android:textColor="@color/dash_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/charge_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/nav_close"
                android:scaleType="center"
                android:src="@drawable/ic_hvac_close" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- ── Gauche : batterie, curseur de la limite, temps restant ── -->
            <LinearLayout
                android:layout_width="290dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_hvac_panel"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charge_popup_battery"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/charge_soc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="58sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    tools:text="62,4 %" />

                <com.mg4.control.ui.widget.ChargeLimitSliderView
                    android:id="@+id/charge_slider"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/charge_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="12sp"
                    android:maxLines="2" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/charge_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/charge_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- ── Centre : courbe depuis le début de la charge ── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_hvac_panel"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/charge_legend_power"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/charge_popup_legend_power"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/charge_legend_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="@string/charge_popup_legend_battery"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/charge_since"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/dash_text_lo"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <com.mg4.control.ui.widget.ChargeCurveView
                    android:id="@+id/charge_curve"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- ── Droite : les chiffres, ou l'éditeur du prix du kWh à leur place ── -->
            <FrameLayout
                android:layout_width="255dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_hvac_panel">

                <LinearLayout
                    android:id="@+id/charge_rows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <include
                        android:id="@+id/row_power"
                        layout="@layout/item_charge_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                    <include
                        android:id="@+id/row_energy"
                        layout="@layout/item_charge_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                    <include
                        android:id="@+id/row_range"
                        layout="@layout/item_charge_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                    <include
                        android:id="@+id/row_cost"
                        layout="@layout/item_charge_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                    <include
                        android:id="@+id/row_duration"
                        layout="@layout/item_charge_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/charge_price_editor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/charge_popup_price_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/price_type"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:id="@+id/price_cancel"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/nav_close"
                            android:scaleType="center"
                            android:src="@drawable/ic_hvac_close" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/price_minus"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_dialog_tile"
                            android:padding="15dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_hvac_minus" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:id="@+id/price_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/price_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:maxLines="1" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/price_plus"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_dialog_tile"
                            android:padding="15dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_hvac_plus" />

                    </LinearLayout>

                    <!-- Le pas des deux boutons ; les cases sont ajoutées par AppDialog.segments -->
                    <LinearLayout
                        android:id="@+id/price_steps"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_dialog_segments"
                        android:orientation="horizontal"
                        android:padding="3dp"
                        android:baselineAligned="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/charge_popup_cost"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/price_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/price_cost_old"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/dash_text_lo"
                            android:textSize="13sp"
                            android:maxLines="1" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/charge_popup_price_note"
                        android:textColor="@color/dash_text_lo"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/price_default"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:background="@drawable/bg_dialog_tile"
                            android:gravity="center"
                            android:text="@string/stats_tariff_default"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/price_ok"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_dialog_primary"
                            android:gravity="center"
                            android:text="@string/charge_popup_price_ok"
                            android:textColor="@color/hvac_on_accent"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
