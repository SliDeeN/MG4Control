<?xml version="1.0" encoding="utf-8"?>
<!-- Carte de profil (refonte 2.7.0) : une grille de trois colonnes. Nom et badges en tête, résumé
     sur deux lignes (cartes de même hauteur), « Appliquer » en grand, puis Modifier / Par défaut /
     Supprimer. Le profil actif prend un fond et un cadre d'accent (ProfileAdapter). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:paddingHorizontal="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_margin="6dp">

    <!-- Nom + badges PAR DÉFAUT et ACTIF -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Poignée : un appui long sur la carte la déplace (ordre des profils). -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_drag_indicator"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_active_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_profile_active"
            android:textColor="@color/dash_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <!-- Badge PAR DÉFAUT -->
        <TextView
            android:id="@+id/tv_default_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_default_badge"
            android:textColor="@color/dash_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_chip_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Résumé : ce que le profil applique, sur deux lignes au plus -->
    <TextView
        android:id="@+id/tv_profile_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="20sp"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/profile_apply_now"
        android:textColor="@color/hvac_on_accent"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="21sp"
        app:autoSizeStepGranularity="1sp"
        app:backgroundTint="@color/dash_accent"
        app:cornerRadius="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/profile_edit"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textAllCaps="false"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeStepGranularity="1sp"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_set_default"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/profile_set_default"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textAllCaps="false"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.9"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/profile_delete"
            android:textColor="@color/dash_danger"
            android:textSize="19sp"
            android:textAllCaps="false"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeStepGranularity="1sp"
            app:backgroundTint="@color/dash_danger_dim"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_danger"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
