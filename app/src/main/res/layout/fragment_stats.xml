<?xml version="1.0" encoding="utf-8"?>
<!--
    Onglet Statistiques : rail de trois sous-onglets (Général / Trajets / Recharge) et trois pages
    dans le même arbre de vues, comme le tableau de bord.

    Les tuiles de résumé et les lignes de listes sont construites par StatsFragment : leur nombre
    dépend de ce que la voiture a rendu, et une tuile sans valeur ne doit pas occuper la place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:padding="14dp">

    <!-- Refonte B : sous-onglets en pastilles au-dessus du contenu ; la rangée défile si elle dépasse. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.mg4.control.ui.widget.RailButton
                style="@style/Widget.MG4.CategoryTab"
                android:id="@+id/btn_stats_cat_general"
                android:text="@string/stats_cat_general"
                app:icon="@drawable/ic_rail_chart" />

            <com.mg4.control.ui.widget.RailButton
                style="@style/Widget.MG4.CategoryTab"
                android:id="@+id/btn_stats_cat_trips"
                android:text="@string/stats_cat_trips"
                app:icon="@drawable/ic_rail_route" />

            <com.mg4.control.ui.widget.RailButton
                style="@style/Widget.MG4.CategoryTab"
                android:id="@+id/btn_stats_cat_charges"
                android:text="@string/stats_cat_charges"
                app:icon="@drawable/ic_rail_bolt" />

        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/scroll_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════ Général ══════════ -->
            <LinearLayout
                android:id="@+id/page_stats_general"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_enable_label"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/stats_enable_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="19sp" />

                        </LinearLayout>

                        <com.mg4.control.ui.widget.SegmentSwitch
                            android:id="@+id/switch_stats_enabled"
                            android:layout_marginHorizontal="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/stats_disabled_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/stats_disabled_note"
                        android:textColor="@color/dash_text_lo"
                        android:textSize="18sp" />

                </LinearLayout>

                <!-- Bloc visible seulement quand l'enregistrement est actif -->
                <LinearLayout
                    android:id="@+id/stats_general_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_summary_title"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/stats_summary_tiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_stats_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_battery_title"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stats_battery_label"
                                android:textColor="@color/text_primary"
                                android:textSize="19sp" />

                            <Spinner
                                android:id="@+id/spinner_stats_battery"
                                android:layout_width="wrap_content"
                                android:layout_height="64dp" />

                        </LinearLayout>

                        <!-- État de santé (SOH), 50 à 100 % par 0,5 : − et + maintenus pour aller
                             vite, sans clavier. Posé par StatsFragment.bindStateOfHealth. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stats_soh_label"
                                android:textColor="@color/text_primary"
                                android:textSize="19sp" />

                            <ImageView
                                android:id="@+id/btn_stats_soh_minus"
                                android:layout_width="52dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_dialog_tile"
                                android:padding="14dp"
                                android:contentDescription="@string/stats_soh_less"
                                android:src="@drawable/ic_hvac_minus" />

                            <TextView
                                android:id="@+id/tv_stats_soh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="96dp"
                                android:gravity="center"
                                android:textColor="@color/dash_accent"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btn_stats_soh_plus"
                                android:layout_width="52dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_dialog_tile"
                                android:padding="14dp"
                                android:contentDescription="@string/stats_soh_more"
                                android:src="@drawable/ic_hvac_plus" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stats_soh_effective"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/dash_accent"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stats_battery_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_price_title"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/stats_price_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stats_price_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_cat_trips"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stats_skip_short_label"
                                android:textColor="@color/text_primary"
                                android:textSize="19sp" />

                            <com.mg4.control.ui.widget.SegmentSwitch
                                android:id="@+id/switch_stats_skip_short"
                                android:layout_marginHorizontal="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/stats_min_trip_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stats_skip_short_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_retention_title"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/stats_retention_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stats_retention_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/stats_history_size"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="19sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_stats_clear"
                                android:layout_width="wrap_content"
                                android:layout_height="64dp"
                                android:text="@string/stats_clear"
                                android:textColor="@color/dash_danger"
                                android:textSize="19sp"
                                app:backgroundTint="@color/dash_btn"
                                app:strokeWidth="1dp"
                                app:strokeColor="@color/dash_danger"
                                app:cornerRadius="14dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════ Trajets ══════════ -->
            <LinearLayout
                android:id="@+id/page_stats_trips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_cat_trips"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/stats_trips_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stats_trips_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp" />

            </LinearLayout>

            <!-- ══════════ Recharge ══════════ -->
            <LinearLayout
                android:id="@+id/page_stats_charges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/stats_battery_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_warn_rounded"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/stats_battery_banner_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stats_battery_ok"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp"
                        android:text="@string/stats_battery_banner_ok"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stats_battery_change"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/stats_battery_banner_change"
                        android:textColor="@color/dash_warn"
                        android:textSize="19sp"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_warn"
                        app:cornerRadius="14dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_cat_charges"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/stats_charges_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stats_charges_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
