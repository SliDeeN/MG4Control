<?xml version="1.0" encoding="utf-8"?>
<!-- Popup « mise à jour disponible », affiché par-dessus l'infodivertissement.
     Même squelette qu'overlay_profile_confirm : fond assombri cliquable (= plus tard),
     carte centrée, message encadré, puis les actions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/update_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="40dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingHorizontal="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Message encadré : le titre, puis les deux versions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_confirm_message"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/update_overlay_title"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:lineSpacingExtra="6dp" />

            <!-- « 2.6.6 → 2.6.7 » : c'est l'information qu'on vient chercher, elle a droit à
                 sa propre ligne et à la couleur d'accent. -->
            <TextView
                android:id="@+id/update_versions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/dash_accent"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Installer (accent) / Ignorer (neutre), mêmes proportions que OUI/NON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_btn_install"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/update_overlay_install"
                android:textColor="@color/dash_accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_accent_dim"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_btn_skip"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/update_overlay_skip"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Volontairement effacé : c'est le seul bouton qui coupe une fonction, il ne doit
             pas se toucher par réflexe en visant l'un des deux autres. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_btn_disable"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/update_overlay_disable"
            android:textColor="@color/dash_text_lo"
            android:textSize="15sp"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
