<?xml version="1.0" encoding="utf-8"?>
<!-- « Une mise à jour est disponible » : un BANDEAU en bas de l'écran, le même que la confirmation
     OUI / NON d'une automatisation — proposition « A » choisie sur maquette le 2026-10-13. Il
     n'assombrit ni ne cache l'écran derrière lui.

     À gauche l'annonce : la version installée, celle qui est proposée, et la sortie définitive
     « ne plus me prévenir », en simple lien. À droite les trois réponses : plus tard — retenue
     d'office quand le délai s'écoule —, ignorer cette version, installer.

     Rien n'est peint ici hors la carte : fonds et teintes sont posés par UpdateOverlay, qui suit
     le thème de l'application. Tailles DE BASE, agrandies comme celles des autres pop-ups. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/update_card"
        android:layout_width="1108dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:background="@drawable/bg_hvac_modern_card"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/update_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_overlay_update" />

        <!-- ── L'annonce ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_overlay_title"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/update_version_current"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/update_arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_overlay_arrow" />

                <TextView
                    android:id="@+id/update_version_new"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <!-- Sortie définitive, rare : un lien, mais haut de toute la ligne pour le doigt.
                     Il prend la place qui reste et se coupe si les numéros de version sont longs. -->
                <TextView
                    android:id="@+id/update_btn_disable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:text="@string/update_overlay_disable"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Les réponses ── -->
        <LinearLayout
            android:id="@+id/update_btn_later"
            android:layout_width="150dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_later_btn"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/update_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/update_btn_skip"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/update_overlay_skip"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <LinearLayout
            android:id="@+id/update_btn_install"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/update_install_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_overlay_update" />

            <!-- Deux lignes permises : en espagnol et en italien le libellé ne tient pas sur une. -->
            <TextView
                android:id="@+id/update_install_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/update_overlay_install"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
