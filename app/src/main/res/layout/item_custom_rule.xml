<?xml version="1.0" encoding="utf-8"?>
<!-- Une automatisation de « Mes automatisations » (issue #201) : nom et interrupteur, résumé
     Quand / Si / Alors, dernière exécution, Modifier, Tester et Supprimer. Rempli par CustomRulesPage. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rule_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <com.mg4.control.ui.widget.SegmentSwitch
            android:id="@+id/rule_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/rule_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="19sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rule_last_run"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/dash_text_lo"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_edit"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:minWidth="140dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rule_menu_edit"
            android:textColor="@color/dash_accent"
            android:textSize="19sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_accent_dim"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_accent"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_test"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:minWidth="140dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rule_test"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rule_delete"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:minWidth="140dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rule_delete"
            android:textColor="@color/dash_danger"
            android:textSize="19sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/dash_danger_dim"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_danger"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
