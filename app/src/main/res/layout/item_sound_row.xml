<?xml version="1.0" encoding="utf-8"?>
<!-- Sons d'automatisation (liste du 2026-10-29) : une ligne par son — nom, fichier, durée, moments,
     volume —, dépliée pour régler le son. Le cadre est peint par le code (accent quand elle est
     ouverte). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/sound_row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♪"
            android:textColor="@color/dash_accent"
            android:textSize="24sp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/sound_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/sound_row_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxWidth="280dp"
            android:textColor="@color/text_secondary"
            android:textSize="19sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/sound_row_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/sound_row_events"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sound_row_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/sound_row_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="22sp"
            android:importantForAccessibility="no" />

    </LinearLayout>

    <include
        android:id="@+id/sound_row_body"
        layout="@layout/item_sound_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
