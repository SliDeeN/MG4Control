<?xml version="1.0" encoding="utf-8"?>
<!-- « Restaurer les profils ? » : proposée à l'ouverture de l'application quand elle n'a aucun
     profil mais qu'une sauvegarde existe sur la voiture (après une réinstallation). Proposition
     « B » choisie sur maquette le 2026-10-13 : la fenêtre MONTRE les profils retrouvés — on ne
     répond qu'une fois, autant savoir à quoi.

     Fenêtre de l'application : tailles normales, pas l'agrandissement des pop-ups. Les cartes de
     profil (item_dialog_profile.xml) sont ajoutées par RestoreProfilesDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hvac_modern_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_dialog_icon">

            <ImageView
                android:id="@+id/restore_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dialog_restore" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_restore_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/restore_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Les profils retrouvés. Jusqu'à quatre, ils se partagent la largeur ; au-delà la rangée défile. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/restore_profiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false" />

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/restore_btn_ignore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_tile"
            android:gravity="center"
            android:text="@string/profile_restore_cancel"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/restore_btn_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_dialog_primary"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/restore_confirm_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dialog_restore" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/profile_restore_confirm"
                android:textColor="@color/hvac_on_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
