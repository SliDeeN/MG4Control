<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system">

    <!-- Permissions — same as original DriveHub Dort -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- [T-910] Exigée à partir d'API 34 pour foregroundServiceType="connectedDevice". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Vehicle control permissions (Android Automotive / SAIC) -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- [BT-PROFILES] Bluetooth — lecture des appareils appairés et suivi connexions -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- [T-902] "com.saic.keyevent.hardkey.report" n'est pas un broadcast protégé :
         n'importe quelle app installée peut le forger et piloter les raccourcis, donc
         écrire mode de conduite / régen / ADAS / AEB. Le receiver exige désormais cette
         permission côté ÉMETTEUR. En protectionLevel="signature", seule une app signée
         avec la clé plateforme de la ROM l'obtient — c'est le cas de l'émetteur système
         d'origine, jamais d'une app tierce. -->
    <permission
        android:name="com.mg4.control.permission.RECEIVE_HARDKEY"
        android:protectionLevel="signature" />

    <!-- External control API. In protectionLevel="signature", only an app signed with the
         same platform key can bind ProfileControlService. MG4Control declares the permission
         to protect that service; any such app may list and apply MG4Control profiles. -->
    <permission
        android:name="com.mg4.control.permission.CONTROL_PROFILES"
        android:protectionLevel="signature" />

    <!-- Réseau / auto-update : déclarés UNIQUEMENT dans le flavor online
         (src/online/AndroidManifest.xml). Le flavor offline n'en a aucun, par construction. -->

    <application
        android:name=".MG4App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MG4Control"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <!-- API Car AOSP (CarDoorLockManager pour la détection d'ouverture de porte) -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [T-910] foregroundServiceType est OBLIGATOIRE à partir d'API 34 : sans lui,
             startForeground() lève MissingForegroundServiceTypeException. Sans effet sur
             AAOS 9 (API 28), mais le déclarer maintenant évite un crash au premier bump de
             SDK. "connectedDevice" correspond à ce que fait le service : suivre l'état du
             véhicule et les connexions Bluetooth. -->
        <service
            android:name=".service.MG4ControlService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- External control API (profiles). exported=true because the caller is another
             app, but access is closed by the signature permission: only an app signed with
             the ROM platform key can bind. The service exposes no raw property write —
             only listing and applying MG4Control profiles. -->
        <service
            android:name=".api.ProfileControlService"
            android:exported="true"
            android:permission="com.mg4.control.permission.CONTROL_PROFILES" />

        <!-- FileProvider + InstallReceiver (auto-update) : déclarés UNIQUEMENT dans
             le flavor online (src/online/AndroidManifest.xml). Déplacer le FileProvider
             hors du manifest de base évite aussi un conflit d'authority qui empêcherait
             d'installer les APK online et offline côte à côte. -->

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:priority="1000">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
