<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:padding="20dp"
    android:minWidth="360dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
        <Button
            android:id="@+id/btnCloseSettings"
            style="@style/Widget.MG4Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/btn_close"
            android:paddingHorizontal="12dp"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Langue -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_language"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button
            android:id="@+id/btnLangFr"
            style="@style/Widget.MG4Control.Button.ParamBlue"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/lang_french"
            android:layout_marginEnd="6dp"/>
        <Button
            android:id="@+id/btnLangEn"
            style="@style/Widget.MG4Control.Button.ParamBlue"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/lang_english"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Séparateur -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" android:layout_marginBottom="12dp"/>

    <!-- Logs -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_logs"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnOpenLogs"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/btn_logs"
        android:textSize="12sp"/>

    <!-- Séparateur -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

    <!-- Diagnostic ADAS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_diag"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnDiagAdas"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/btn_diag_adas"
        android:textSize="12sp"/>

</LinearLayout>
