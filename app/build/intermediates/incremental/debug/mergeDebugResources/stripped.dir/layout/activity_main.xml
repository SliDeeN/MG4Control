<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.48"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnSnow,btnOnePedal"/>

    <!-- Header -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textSize="12sp"
        android:textColor="@color/status_disconnected"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/tvAppTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toEndOf="@id/tvAppTitle"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"/>

    <Button
        android:id="@+id/btnSettings"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/btn_settings"
        android:paddingHorizontal="10dp"
        android:textSize="11sp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnProfiles"/>

    <Button
        android:id="@+id/btnProfiles"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/btn_profiles"
        android:paddingHorizontal="10dp"
        android:textSize="11sp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLogs"/>

    <Button
        android:id="@+id/btnLogs"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/btn_logs"
        android:paddingHorizontal="10dp"
        android:textSize="11sp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnRefresh"/>

    <Button
        android:id="@+id/btnRefresh"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/btn_refresh"
        android:paddingHorizontal="10dp"
        android:textSize="11sp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnConnect"/>

    <Button
        android:id="@+id/btnConnect"
        style="@style/Widget.MG4Control.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/btn_connect"
        android:paddingHorizontal="10dp"
        android:textSize="11sp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- COLONNE GAUCHE — Mode de conduite -->
    <TextView
        android:id="@+id/tvDrivingLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/section_drive_mode"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter"/>

    <Button
        android:id="@+id/btnEco"
        style="@style/Widget.MG4Control.Button.DriveMode"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:text="@string/btn_eco"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvDrivingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnNormal"/>

    <Button
        android:id="@+id/btnNormal"
        style="@style/Widget.MG4Control.Button.DriveMode"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:text="@string/btn_normal"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvDrivingLabel"
        app:layout_constraintStart_toEndOf="@id/btnEco"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter"/>

    <Button
        android:id="@+id/btnSport"
        style="@style/Widget.MG4Control.Button.DriveMode"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:text="@string/btn_sport"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnEco"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSnow"/>

    <Button
        android:id="@+id/btnSnow"
        style="@style/Widget.MG4Control.Button.DriveMode"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:text="@string/btn_snow"
        android:layout_marginTop="5dp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnNormal"
        app:layout_constraintStart_toEndOf="@id/btnSport"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter"/>

    <!-- COLONNE DROITE — Régénération + One Pedal -->
    <TextView
        android:id="@+id/tvRegenLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/section_regen"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:layout_marginTop="10dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnRegenLow"
        style="@style/Widget.MG4Control.Button.Regen"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/btn_regen_low"
        android:layout_marginTop="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvRegenLabel"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintEnd_toStartOf="@id/btnRegenStd"/>

    <Button
        android:id="@+id/btnRegenStd"
        style="@style/Widget.MG4Control.Button.Regen"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/btn_regen_std"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvRegenLabel"
        app:layout_constraintStart_toEndOf="@id/btnRegenLow"
        app:layout_constraintEnd_toStartOf="@id/btnRegenHigh"/>

    <Button
        android:id="@+id/btnRegenHigh"
        style="@style/Widget.MG4Control.Button.Regen"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/btn_regen_high"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvRegenLabel"
        app:layout_constraintStart_toEndOf="@id/btnRegenStd"
        app:layout_constraintEnd_toStartOf="@id/btnRegenAuto"/>

    <Button
        android:id="@+id/btnRegenAuto"
        style="@style/Widget.MG4Control.Button.Regen"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/btn_regen_auto"
        android:layout_marginTop="6dp"
        android:layout_marginStart="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvRegenLabel"
        app:layout_constraintStart_toEndOf="@id/btnRegenHigh"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnOnePedal"
        style="@style/Widget.MG4Control.Button.OnePedal"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/btn_one_pedal_off"
        android:layout_marginTop="5dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnRegenLow"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BAS — Alertes vitesse -->
    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/barrierBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvAlertsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_alerts"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider2"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnSlifWarning"
        style="@style/Widget.MG4Control.Button.OnePedal"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:text="@string/btn_overspeed_off"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvAlertsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSpeedLimitChangeTone"/>

    <Button
        android:id="@+id/btnSpeedLimitChangeTone"
        style="@style/Widget.MG4Control.Button.OnePedal"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:text="@string/btn_speed_tone_off"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvAlertsLabel"
        app:layout_constraintStart_toEndOf="@id/btnSlifWarning"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Feedback -->
    <TextView
        android:id="@+id/tvLastAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/accent_green"
        android:textSize="12sp"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/btnSlifWarning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
