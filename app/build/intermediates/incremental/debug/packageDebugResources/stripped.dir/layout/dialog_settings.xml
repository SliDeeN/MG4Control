<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp"
    android:minWidth="320dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <Button
            android:id="@+id/btnCloseSettings"
            style="@style/Widget.MG4Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/btn_close"
            android:paddingHorizontal="12dp"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Langue -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_language"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnLangFr"
            style="@style/Widget.MG4Control.Button.DriveMode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/lang_french"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLangEn"
            style="@style/Widget.MG4Control.Button.DriveMode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/lang_english"
            android:textSize="13sp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvCurrentLang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_language_current"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textAlignment="center"
        android:layout_marginTop="4dp"/>

</LinearLayout>
