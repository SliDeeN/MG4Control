<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ── HEADER ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_disconnected"
            android:textSize="12sp"
            android:textColor="@color/status_disconnected"
            android:background="@drawable/bg_status"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnConnect"
            style="@style/Widget.MG4Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_connect"
            android:paddingHorizontal="12dp"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnProfiles"
            style="@style/Widget.MG4Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_profiles"
            android:paddingHorizontal="12dp"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnSettings"
            style="@style/Widget.MG4Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_settings"
            android:paddingHorizontal="12dp"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- ── PARAMÈTRES DE CONDUITE (pleine largeur) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:layout_marginBottom="8dp"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_drive_mode_full"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- 3 blocs côte à côte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- MODE DE CONDUITE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_block"
                android:layout_marginEnd="6dp"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_drive_mode"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button
                        android:id="@+id/btnEco"
                        style="@style/Widget.MG4Control.Button.ParamBlue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_eco"
                        android:layout_marginEnd="3dp"/>
                    <Button
                        android:id="@+id/btnNormal"
                        style="@style/Widget.MG4Control.Button.ParamBlue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_normal"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnSport"
                        style="@style/Widget.MG4Control.Button.ParamBlue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_sport"
                        android:layout_marginEnd="3dp"/>
                    <Button
                        android:id="@+id/btnSnow"
                        style="@style/Widget.MG4Control.Button.ParamBlue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_snow"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- RÉGÉNÉRATION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_block"
                android:layout_marginEnd="6dp"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_regen"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button
                        android:id="@+id/btnRegenLow"
                        style="@style/Widget.MG4Control.Button.ParamGreen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_regen_low"
                        android:layout_marginEnd="3dp"/>
                    <Button
                        android:id="@+id/btnRegenStd"
                        style="@style/Widget.MG4Control.Button.ParamGreen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_regen_std"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button
                        android:id="@+id/btnRegenHigh"
                        style="@style/Widget.MG4Control.Button.ParamGreen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_regen_high"
                        android:layout_marginEnd="3dp"/>
                    <Button
                        android:id="@+id/btnRegenAuto"
                        style="@style/Widget.MG4Control.Button.ParamGreen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_regen_auto"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnOnePedal"
                    style="@style/Widget.MG4Control.Button.ParamGreen"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/btn_one_pedal_off"/>
            </LinearLayout>

            <!-- AIDE À LA CONDUITE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_block"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_adas"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button
                        android:id="@+id/btnAdasOff"
                        style="@style/Widget.MG4Control.Button.ParamAmber"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_adas_off"
                        android:layout_marginEnd="3dp"/>
                    <Button
                        android:id="@+id/btnAdasLim"
                        style="@style/Widget.MG4Control.Button.ParamAmber"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_adas_lim"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnAdasAcc"
                        style="@style/Widget.MG4Control.Button.ParamAmber"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_adas_acc"
                        android:layout_marginEnd="3dp"/>
                    <Button
                        android:id="@+id/btnAdasIca"
                        style="@style/Widget.MG4Control.Button.ParamAmber"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/btn_adas_ica"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── PARAMÈTRES D'ALERTES (pleine largeur, en dessous) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_alerts_full"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSlifWarning"
                style="@style/Widget.MG4Control.Button.Alert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_overspeed_off"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSpeedLimitChangeTone"
                style="@style/Widget.MG4Control.Button.Alert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_speed_tone_off"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvLastAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</LinearLayout>
