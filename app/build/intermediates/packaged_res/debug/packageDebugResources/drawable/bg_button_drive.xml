<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sélectionné (mode actif) -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp"/>
                    <solid android:color="#FF1A2E45"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp"/>
                    <stroke android:width="2dp" android:color="@color/accent_blue"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressé -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#FF2A3A50"/>
            <stroke android:width="1dp" android:color="@color/accent_blue"/>
        </shape>
    </item>

    <!-- Désactivé -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#FF151520"/>
            <stroke android:width="1dp" android:color="#FF202030"/>
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="@color/bg_button"/>
            <stroke android:width="1dp" android:color="@color/border_default"/>
        </shape>
    </item>

</selector>
